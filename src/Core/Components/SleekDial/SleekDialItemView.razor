@namespace FluentUI.Blazor.Community.Components
@inherits FluentComponentBase

@if (Item is not null)
{
    <div class="@InternalClass"
         style="@InternalStyle"
         tabindex="@Index"
         @ref="_root"
         @onclick="OnClickAsync">
        <FluentButton Disabled="@Item.Disabled"
                      Title="@Item.Title"
                      Shape="ButtonShape.Circular"
                      IconStart="@Item.Icon"
                      Size="ButtonSize.Large"
                      ChildContent="@(!string.IsNullOrEmpty(Item.Text) ? _renderText(Item.Text) : null)"
                      Style="position: relative;" />
    </div>
}

@code {
    private readonly RenderFragment<string> _renderText = text => __builder =>
    {
        <FluentText>@text</FluentText>
    };
}
