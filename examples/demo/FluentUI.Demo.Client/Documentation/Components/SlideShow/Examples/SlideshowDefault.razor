        Hello World
    </FluentCxSlideShowItem>

    <FluentCxSlideShowItem>
        Hello World2
    </FluentCxSlideShowItem>
</FluentCxSlideShow>

@code {

    Orientation orientation = Orientation.Horizontal;
}
