@namespace FluentUI.Blazor.Community.Components
@using FluentUI.Blazor.Community.Components.Chat.UI.Messages
@inherits FluentComponentBase
@typeparam TFile where TFile : class, new()

<div id="@Id" class="@InternalCss" style="@Style">
    <div style="height: 100%" hidden-when="xs sm">
        <FluentMultiSplitter Style="@TransparentBarStyle">
            <FluentMultiSplitterPane Resizable="false" Size="30%">
                @_renderChatRoom
            </FluentMultiSplitterPane>
            <FluentMultiSplitterPane>
                @_renderChatMessageList
            </FluentMultiSplitterPane>
        </FluentMultiSplitter>
    </div>

    <div hidden-when="md lg xl xxl">
    </div>
</div>


@code {
    public FluentCxChat(LibraryConfiguration configuration)
        : base(configuration)
    {
        _renderChatRoom = __builder =>
        {
            <ChatRoomListView Owner="@Owner"
                              EmptyContent="@RoomEmptyContent"
                              ItemsProvider="@RoomItemsProvider"
                              ItemTemplate="@RoomTemplate"
                              LoadingContent="@RoomLoadingContent"
                              OnArchiveChanged="@OnRoomArchiveChanged"
                              OnBlockChanged="@OnRoomBlockChanged"
                              OnDelete="@OnRoomDelete"
                              OnHideChanged="@OnRoomHideChanged"
                              OnMuteChanged="@OnRoomMuteChanged"
                              OnNewChatGroup="@OnRoomCreate"
                              OnPinChanged="@OnRoomPinChanged"
                              OnRename="@OnRoomRename"
                              RoomNameComparison="@RoomNameComparison"
                              RoomSearchProvider="@RoomSearchProvider"
                              ShowDeletedRoom="@ShowDeletedRooms"
                              UserNameComparison="@UserNameComparison"
                              UserSearchProvider="@UserSearchProvider"
                              />

        };

        _renderChatMessageList = __builder =>
        {
            <ChatView TItem="TFile"
                      AppendFiles=@AppendFiles
                      AudioWaveVisualizerContent=@AudioWaveVisualizerContent
                      ChatFileRenderingMode=@ChatFileRenderingMode
                      CheckmarkIcon=@ChatViewIcons.Checkmark
                      CountProvider=@MessageCountProvider
                      DeletedMessageTemplate=@DeletedMessageTemplate
                      DismissIcon=@ChatViewIcons.Dismiss
                      EmojiIcon=@ChatViewIcons.Emoji
                      EmojiSettings=@EmojiSettings
                      EmptyRoomContent=@EmptyRoomContent
                      FilesProvider=@FilesProvider
                      FileTemplate=@FileTemplate
                      Filter=@MessageFilter
                      GiftIcon=@ChatViewIcons.Gift
                      ImportOptions="@ImportOptions"
                      IsEmojiInsertionAllowed="@ChatCapabilities.HasFlag(ChatViewCapabilities.Emoji)"
                      IsGiftAllowed="@ChatCapabilities.HasFlag(ChatViewCapabilities.Gift)"
                      IsMediaInsertionAllowed="@ChatCapabilities.HasFlag(ChatViewCapabilities.Media)"
                      IsRecordingAudioEnabled="@ChatCapabilities.HasFlag(ChatViewCapabilities.Audio)"
                      IsTranslationEnabled="@IsTranslationEnabled"
                      IsReactEnabled="@ChatCapabilities.HasFlag(ChatViewCapabilities.React)"
                      ItemRetrieveProvider="@ItemRetrieveProvider"
                      ItemsProvider="@ItemsProvider"
                      LoadingContent="@LoadingContent"
                      LoadingFileContent="@LoadingFileContent"
                      MaxItemCount="@MaxItemCount"
                      MediaIcon="@ChatViewIcons.Media"
                      MessageSplitOption="@MessageSplitOption"
                      MessageTemplate="@MessageTemplate"
                      MessageWriterOrientation="@MessageWriterOrientation"
                      MicroIcon="@ChatViewIcons.Micro"
                      MicroOffIcon="@ChatViewIcons.MicroOff"
                      OnCreate="@OnCreateMessage"
                      OnDelete="@OnDeleteMessage"
                      OnEditMessage="@OnEditMessage"
                      OnGift="@OnGift"
                      OnPinOrUnpin="@OnPinOrUnpinMessage"
                      OnReactMessage="@OnReactMessage"
                      OverscanCount="@OverscanCount"
                      Owner="@Owner"
                      ReactionsProvider="@ReactionsProvider"
                      ReadUserStateProvider="@ReadUserStateProvider"
                      SendIcon="@ChatViewIcons.Send"
                      SendingContent="@SendingContent"
                      SendingRenderMode="@SendingRenderMode"
                      ShowDeletedMessages=@ShowDeletedMessages
                      OnRead="@OnRead"/>
        };
    }
}
