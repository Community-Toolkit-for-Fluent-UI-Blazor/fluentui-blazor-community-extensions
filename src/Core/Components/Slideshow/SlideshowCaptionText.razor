@namespace FluentUI.Blazor.Community.Components
@inherits FluentComponentBase

<FluentText Id="@Id"
            Class="@Class"
            Style="@Style"
            CustomColor="@Color"
            Font="@Font"
            Size="@Size"
            Margin="@Margin"
            Italic="@Italic"
            Weight="@Weight"
            Padding="@Padding"
            Strikethrough="@Strikethrough"
            Underline="@Underline"
            Align="@Align"
            Truncate="@Truncate"
            As="@As"
            Nowrap="@Nowrap"
            Block="@Block"
            Color="@(!string.IsNullOrEmpty(Color) ? Microsoft.FluentUI.AspNetCore.Components.Color.Custom : Microsoft.FluentUI.AspNetCore.Components.Color.Default)"
            role="presentation"
            @attributes="@AdditionalAttributes">
    @ChildContent
</FluentText>
