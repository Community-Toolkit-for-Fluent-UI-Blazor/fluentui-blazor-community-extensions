@namespace FluentUI.Blazor.Community.Components.Chat.UI.Dialogs
@inherits FluentDialogInstance

<FluentDialogBody Id="@Id">
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size24.ContentView())" />

            <FluentText Size="TextSize.Size700">
                @Localizer[LanguageResource.CX_Chat_Message_Viewer_Title]
            </FluentText>
        </FluentStack>
    </TitleTemplate>

    <ChildContent>
        <FluentCxSlideshow ContentRatio="SlideshowContentRatio.Landscape"
                           RatioMode="SlideshowRatioMode.Container"
                           IsTouchEnabled
                           InsideDialog>
            @if (_files.Count > 0)
            {
                var videoFiles = _files.Where(f => f.ContentType.StartsWith(FluentCxConstants.VideoContentType, StringComparison.OrdinalIgnoreCase)).ToList();

                if (videoFiles.Count > 0)
                {
                    <SlideshowItem>
                        <SlideshowVideo Files="@videoFiles"
                                        GetChapters="@GetChapters"
                                        IsDownloadVisible="false"
                                        IsFullscreenDisabled
                                        IsPlaybackSpeedVisible
                                        ShowThumbnails
                                        GetVideoMetadata="@GetVideoMetadata" />
                    </SlideshowItem>
                    
                }

                var imageFiles = _files.Where(f => f.ContentType.StartsWith(FluentCxConstants.ImageContentType, StringComparison.OrdinalIgnoreCase)).ToList();

                if (imageFiles.Count > 0)
                {
                    foreach (var file in imageFiles)
                    {
                        <SlideshowItem>
                            <SlideshowImage Source="@file.Url" />
                        </SlideshowItem>
                    }
                }

                var audioFiles = _files.Where(f => f.ContentType.StartsWith(FluentCxConstants.AudioContentType, StringComparison.OrdinalIgnoreCase)).ToList();

                if (audioFiles.Count > 0)
                {
                    
                }
            }
        </FluentCxSlideshow>
    </ChildContent>
</FluentDialogBody>
