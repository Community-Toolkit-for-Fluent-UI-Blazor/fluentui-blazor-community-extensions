@namespace FluentUI.Blazor.Community.Components.Chat.UI.Dialogs
@inherits FluentComponentBase

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size24.HardDrive().WithColor(Color.Primary))" />

            <FluentText Size="TextSize.Size700">
                @Dialog.Options.Header.Title
            </FluentText>
        </FluentStack>
    </TitleTemplate>

    <ChildContent>
        <FluentInputFile Id="@Id"
                         Mode=InputFileMode.Buffer
                         MaximumFileCount=@_maximumFileCount
                         MaximumFileSize=@(1024 * 1024 * 100)
                         Multiple
                         OnProgressChange="@OnProgressChangedAsync"
                         OnFileUploaded=OnFileUploadedAsync
                         Accept="@Accept"
                         Style="height: 300px"
                         ProgressTemplate="@_progressTemplate">
            <ChildContent>
                <label for="@Id">
                    <FluentIcon Value="@(new Size24.ArrowUpload().WithColor(Color.Primary))" />
                </label>

                <div>
                    @((MarkupString)Localizer[LanguageResource.CX_Chat_Message_DragDropFileLabel, Id!, _maximumFileCount])
                </div>
            </ChildContent>
        </FluentInputFile>

        <div style="height: 140px; overflow-y: auto">
            @foreach (var item in _hardUploadedEventArgsList)
            {
                <FluentCard Margin="@(Microsoft.FluentUI.AspNetCore.Components.Margin.Vertical1)">
                    <FluentStack VerticalAlignment="VerticalAlignment.Center">
                        <FluentIcon Value="@(FileIcons.GetIcon(Path.GetExtension(item.Name), FileView.SmallIcons))" />

                        <FluentStack Orientation="Orientation.Vertical" Margin="@Microsoft.FluentUI.AspNetCore.Components.Margin.Horizontal2">
                            <FluentText Truncate Weight="TextWeight.Semibold">
                                @item.Name
                            </FluentText>
                            <FluentText Size="TextSize.Size200"
                                        Color="@Color.Custom"
                                        CustomColor="@SystemColors.Neutral.Foreground3">
                                @ByteSize.FromBytes(item.GetLength()).ToString()
                            </FluentText>
                        </FluentStack>

                        <FluentButton OnClick="@(() => _hardUploadedEventArgsList.Remove(item))"
                                      IconStart="@(new Size24.Delete())"
                                      Appearance="ButtonAppearance.Subtle"
                                      IconOnly="true" />
                    </FluentStack>
                </FluentCard>
            }
        </div>
    </ChildContent>

    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      OnClick="@OnCloseAsync"
                      Disabled="@(_hardUploadedEventArgsList.Count == 0)">
            @Localizer[LanguageResource.CX_Chat_Message_Import_DialogOK]
        </FluentButton>

        <FluentButton OnClick="@OnCancelAsync">
            @Localizer[LanguageResource.CX_Chat_Message_Import_DialogCancel]
        </FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    /// <summary>
    /// Initializes a new instance of the <see cref="ChatFileUploaderDialog" /> class.
    /// </summary>
    public ChatFileUploaderDialog(LibraryConfiguration configuration)
        : base(configuration)
    {
        Id = Identifier.NewId();

        _progressTemplate = file => __builder =>
        {
            if (file.Percentage > 0)
            {
                <FluentProgressBar Min="0" Max="100" Value="@file.Percentage" />
                <br />

                @if (file.Percentage < 100)
                {
                    @Localizer[LanguageResource.CX_Chat_Message_Import_Progression, file.Index + 1, file.Name]
                }
                else
                {
                    @Localizer[LanguageResource.CX_Chat_Message_Import_Completed]
                }
            }
        };
    }
}
