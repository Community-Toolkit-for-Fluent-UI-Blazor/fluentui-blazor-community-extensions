@namespace FluentUI.Blazor.Community.Components
@inherits FluentComponentBase

@if (Message is not null &&
     Owner is not null)
{
    if (ShowDeleted && Message.IsDeleted)
    {
        <div>
            @if (DeletedMessageTemplate is not null)
            {
                @DeletedMessageTemplate
            }
            else
            {
                <FluentStack VerticalGap="8px" Orientation="Orientation.Vertical">
                    @_renderHeader

                    <FluentStack HorizontalGap="8px">
                        @if (Owner != Message.Sender)
                        {
                            @_renderAvatar
                        }

                        @_renderDeletedMessage

                        @if (Owner == Message.Sender)
                        {
                            @_renderAvatar
                        }
                    </FluentStack>

                    @_renderFooter
                </FluentStack>
            }
        </div>
    }
    else if (!Message.IsDeleted)
    {
        <div id="@($"message-{Id}-{Message.Id}")">
            @if (MessageTemplate is not null)
            {
                @MessageTemplate(Message)
            }
            else
            {
                <FluentStack Margin="@Microsoft.FluentUI.AspNetCore.Components.Margin.Vertical1"
                             VerticalGap="8px"
                             Orientation="Orientation.Vertical">
                    @_renderHeader

                    <FluentStack VerticalAlignment="VerticalAlignment.Stretch" HorizontalGap="8px">
                        @if (Owner == Message.Sender)
                        {
                            @_renderActionButtons
                        }
                        else
                        {
                            @_renderAvatar
                        }

                        @_renderCard

                        @if (Owner == Message.Sender)
                        {
                            @_renderAvatar
                        }
                        else
                        {
                            @_renderActionButtons
                        }
                    </FluentStack>

                    @_renderFooter
                </FluentStack>
            }
        </div>

        <FluentPopover AnchorId="@($"EmojiButton{Message!.Id}")"
                       @bind-Opened=_isEmojiPopoverVisible
                       Style="width: 500px; height: 450px; max-height:450px">
            <FluentCxEmojiPicker EmojiFontProvider="@EmojiFontProvider"
                                 OnEmojiChanged="@(OnAddEmojiAsync)" />
        </FluentPopover>
    }
}

@code {
    public ChatMessageCard(LibraryConfiguration libraryConfiguration)
        : base(libraryConfiguration)
    {
        Id = Identifier.NewId();

        _tappedCallback = EventCallback.Factory.Create(this, OnTappedAsync);

        _renderHeader = __builder =>
        {
            <FluentStack HorizontalGap="8px" HorizontalAlignment="HorizontalAlignment.Left">
                <FluentText Size="TextSize.Size200">
                    @FormattedDateMessage
                </FluentText>

                <FluentSpacer />

                @if (Message!.EditedDate.HasValue)
                {
                    <FluentText Size="TextSize.Size200">
                        @Localizer[LanguageResource.CX_Chat_Message_Edited]
                    </FluentText>
                }

                @_renderReadState
            </FluentStack>
        };

        _renderActionButtons = __builder =>
        {
            <FluentStack Width="auto"
                         Orientation="Orientation.Vertical"
                         VerticalAlignment="VerticalAlignment.Stretch">
                @if (DynamicState.GetPinState(Message!.Id, Owner!.Id))
                {
                    <FluentIcon Value="@(new Size24.Pin().WithColor(Color.Primary))" />
                }

                <FluentSpacer Orientation="Orientation.Vertical" />

                <FluentButton Id="@($"MoreButton{Message!.Id}")"
                              IconStart="@(new Size24.MoreVertical())" />
            </FluentStack>

            <FluentMenu Trigger="@($"MoreButton{Message!.Id}")">
                <FluentMenuList>
                    @if (DynamicState.GetPinState(Message!.Id, Owner!.Id))
                    {
                        <FluentMenuItem OnClick="@(() => OnPinOrUnpinAsync(false))"
                                        IconStart="@(new Size24.PinOff())">
                            @Localizer[LanguageResource.CX_Chat_Message_Unpin]
                        </FluentMenuItem>
                    }
                    else
                    {
                        <FluentMenuItem OnClick="@(() => OnPinOrUnpinAsync(true))"
                                        IconStart="@(new Size24.Pin())">
                            @Localizer[LanguageResource.CX_Chat_Message_Pin]
                        </FluentMenuItem>
                    }

                    <FluentMenuItem OnClick=@(OnReplyAsync)
                                    IconStart="@(new Size24.ArrowReply())">
                        @Localizer[LanguageResource.CX_Chat_Message_Reply]
                    </FluentMenuItem>

                    @if (Message!.Type == ChatMessageType.Text)
                    {
                        <FluentMenuItem OnClick=@(OnCopyAsync)
                                        IconStart="@(new Size24.Copy())">
                            @Localizer[LanguageResource.CX_Chat_Message_Copy]
                        </FluentMenuItem>

                        @if (Owner == Message!.Sender)
                        {
                            <FluentMenuItem OnClick=@OnEditAsync
                                            IconStart="@(new Size24.Edit())">
                                @Localizer[LanguageResource.CX_Chat_Message_Edit]
                            </FluentMenuItem>
                        }
                    }

                    @if (Owner == Message!.Sender)
                    {
                        <FluentMenuItem OnClick=@OnDeleteAsync
                                        IconStart="@(new Size24.Delete())">
                            @Localizer[LanguageResource.CX_Chat_Message_Delete]
                        </FluentMenuItem>
                    }
                </FluentMenuList>
            </FluentMenu>
        };

        _renderAvatar = __builder =>
        {
            <FluentStack Width="auto" VerticalAlignment="VerticalAlignment.Center">
                <FluentAvatar Size="AvatarSize.Size48"
                              Image="@Message!.Sender!.Avatar"
                              Initials="@Message!.Sender!.Initials" />
            </FluentStack>
        };

        _renderFooter = __builder =>
        {

            <FluentStack HorizontalGap="8px">
                @_renderEmojiButton
                @_renderReactions
            </FluentStack>
        };

        _renderGift = __builder =>
        {

        };

        _renderDocument = __builder =>
        {
            var files = DynamicState.GetFiles(ChatState.RoomView!.Room!, Message!.Id);

            <FluentStack HorizontalGap="8px">
                @foreach (var file in files)
                {
                    if (file is IUrlChatFile f)
                    {
                        if (f.ContentType.StartsWith(FluentCxConstants.ImageContentType, StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="@f.Url" width="120" height="120" alt="@f.Name" fetchpriority="auto" title="@f.Name" loading="lazy" />
                        }
                        else
                        {
                            <FluentIcon Value="@FileIcons.GetIcon(Path.GetExtension(f.Name), FileView.VeryLargeIcons)" Width="120px" />
                        }
                    }
                    else if (file is BinaryChatFile b)
                    {
                        if (b.ContentType.StartsWith(FluentCxConstants.ImageContentType, StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="@($"data:{b.ContentType};base64,{Convert.ToBase64String(b.Content)}")" width="120" height="120" />
                        }
                        else
                        {
                            <FluentIcon Value="@FileIcons.GetIcon(Path.GetExtension(b.Name), FileView.VeryLargeIcons)" Width="120px" />
                        }
                    }
                }
            </FluentStack>
        };

        _renderText = __builder =>
        {
            var section = Message!.Sections.FirstOrDefault(x => x.CultureId == Owner!.CultureId);

            if (section is null)
            {
                section = Message!.Sections[0];
            }

            if (!string.IsNullOrEmpty(section?.Content))
            {
                <FluentText Truncate="true">
                    @((MarkupString)section!.Content!)
                </FluentText>
            }
        };

        _renderMessage = __builder =>
        {
            <FluentStack Orientation="Orientation.Vertical">
                @if (Message!.ReplyToMessageId.HasValue)
                {
                    <ChatMessageReply InsideCard Text="@GetReplyText()" />
                }

                @if (Message.Type.HasFlag(ChatMessageType.Text))
                {
                    @_renderText
                }

                @if (Message.Type.HasFlag(ChatMessageType.Files) ||
                     Message.Type.HasFlag(ChatMessageType.Videos) ||
                     Message.Type.HasFlag(ChatMessageType.Audio) ||
                     Message.Type.HasFlag(ChatMessageType.Images))
                {
                    @_renderDocument
                }

                @if (Message.Type.HasFlag(ChatMessageType.Gift))
                {
                    @_renderGift
                }
            </FluentStack>
        };

        _renderEmojiButton = __builder =>
        {
            <FluentButton OnClick=@(() => _isEmojiPopoverVisible = !_isEmojiPopoverVisible)
                          Id="@($"EmojiButton{Message!.Id}")"
                          IconOnly
                          Shape="ButtonShape.Circular">
                <FluentIcon Value="@(new Size24.EmojiAdd())" />
            </FluentButton>
        };

        _renderReadState = __builder =>
        {
            switch (GetReadState())
            {
                case ChatMessageReadState.Unread:
                    <FluentIcon Title="@Localizer[LanguageResource.CX_Chat_Message_Unread]" Value="@(new Size16.EyeOff().WithColor(Color.Primary))" />
                    break;

                case ChatMessageReadState.PartiallyRead:
                    <FluentIcon Title="@Localizer[LanguageResource.CX_Chat_Message_PartiallyRead]" Value="@(new Size16.Eye().WithColor(Color.Primary))" />
                    break;

                case ChatMessageReadState.FullyRead:
                    <FluentIcon Title="@Localizer[LanguageResource.CX_Chat_Message_FullyRead]" Value="@(new Size16.PeopleCheckmark().WithColor(Color.Primary))" />
                    break;
            }
        };

        _renderReactions = __builder =>
        {
            if (ReactEnabled)
            {
                foreach (var item in GetReactions().Where(x => !string.IsNullOrEmpty(x.Emoji)))
                {
                    <FluentCard Width="auto" Appearance="CardAppearance.Filled">
                        <FluentStack>
                            <div style="@InternalMessageReactionStyle">
                                @item.Emoji
                            </div>

                            <FluentAvatar Initials="@item.UserReactedBy!.Initials"
                                          Size="AvatarSize.Size24"
                                          Image="@item.UserReactedBy?.Avatar" />
                        </FluentStack>
                    </FluentCard>
                }
            }
        };

        _renderCard = __builder =>
        {
            <FluentCard OnClick="@GetTappedCallback()">
                @_renderMessage
            </FluentCard>
        };

        _renderDeletedMessage = __builder =>
        {
            <FluentCard>
                <em>@Localizer[LanguageResource.CX_Chat_Message_ThisMessageWasDeleted]</em>
            </FluentCard>
        };
    }
}
