<div style="width: 100%; height: 600px">
    <FluentCxSlideshow ShowControls
                       ShowIndicators
                       ContentRatio="SlideshowContentRatio.Square"
                       RatioMode="SlideshowRatioMode.Container"
                       IsTouchEnabled
                       IndicatorPosition="SlideshowIndicatorPosition.Bottom">
        <SlideshowItem>
            <SlideshowImage Source="images/ship-1.png" />
            <SlideshowCaption Fixed>
                <FluentText Align="TextAlign.Center"
                            Size="TextSize.Size400"
                            Weight="TextWeight.Bold"
                            Color="Color.Custom"
                            CustomColor="white"
                            As="TextTag.H1">
                    This is a sample caption for the image
                </FluentText>
                <FluentText Weight="TextWeight.Semibold"
                            Align="TextAlign.Center"
                            Color="Color.Custom"
                            CustomColor="white"
                            As="TextTag.Paragraph">
                    images/ship-1
                </FluentText>
            </SlideshowCaption>
        </SlideshowItem>

        <SlideshowItem>
            <SlideshowImage Source="images/ship-2.png" />
            <SlideshowCaption Fixed>
                <FluentText Align="TextAlign.Center"
                            Size="TextSize.Size400"
                            Weight="TextWeight.Bold"
                            Color="Color.Custom"
                            CustomColor="white"
                            As="TextTag.H1">
                    This is a sample caption for the image
                </FluentText>
                <FluentText Weight="TextWeight.Semibold"
                            Align="TextAlign.Center"
                            Color="Color.Custom"
                            CustomColor="white"
                            As="TextTag.Paragraph">
                    images/ship-2
                </FluentText>
            </SlideshowCaption>
        </SlideshowItem>
    </FluentCxSlideshow>
</div>

