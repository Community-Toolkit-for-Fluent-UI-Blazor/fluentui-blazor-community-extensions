@namespace FluentUI.Blazor.Community.Components.Chat.UI.Viewers
@inherits FluentComponentBase

<div id="@Id"
     style="@InternalStyle"
     class="@Class">
    <audio id="@($"audio-{Id}")">
        <source src="@(Source)" />
        Your browser does not support the audio element.
    </audio>

    @if (IsMinimal)
    {
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
                     Style="height: 100%">
            <FluentButton OnClick="OnTappedAsync"
                          Title="@Title"
                          IconStart="@(_isPlaying ? new Size24.Pause() : new Size24.Play())"
                          Style="width: 75%; height: 75%;"
                          Shape="ButtonShape.Circular" />
        </FluentStack>
    }
</div>
