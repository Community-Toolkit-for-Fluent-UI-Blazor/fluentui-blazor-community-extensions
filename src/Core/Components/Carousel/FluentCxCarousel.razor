@namespace FluentUI.Blazor.Community.Components
@inherits FluentComponentBase

<div class="fluentcx-carousel-wrapper">

    <div class="@InternalClass"
         style="@InternalStyle">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>

    @if (_slides.Count > 1)
    {
        @if (ShowControls)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle"
                          Class="fluentcx-carousel-button prev"
                          orientation="@Orientation.ToString().ToLowerInvariant()"
                          OnClick="Previous"
                          IconStart="@GetPreviousIcon()"
                          IconOnly="true" />


            <FluentButton Appearance="ButtonAppearance.Subtle"
                          Class="fluentcx-carousel-button next"
                          orientation="@Orientation.ToString().ToLowerInvariant()"
                          OnClick="Next"
                          IconStart="@GetNextIcon()"
                          IconOnly="true" />
        }

        <div class="dots">
            @for (var i = 0; i < _slides.Count; i++)
            {
                var index = i;

                <button class="dot @(index == CurrentIndex ? "active" : "")"
                        @onclick="() => GoTo(index)">
                </button>
            }
        </div>
    }

</div>

