@namespace FluentUI.Blazor.Community.Components.Chat.UI.Rooms
@inherits FluentComponentBase

<div class="@CssClass"
     style="@Style"
     id="@Id"
     @onclick="HandleClick"
     @onmouseover="() => _hover = true"
     @onmouseout="() => _hover = false">
    @if (Room is not null)
    {
        <FluentStack VerticalAlignment=VerticalAlignment.Center HorizontalGap="8px">

            @if (IsSelected)
            {
                <div class="selection-bar"></div>
            }

            <div class="content-wrapper">
                <FluentStack Orientation="Orientation.Horizontal"
                             VerticalAlignment=VerticalAlignment.Center
                             HorizontalAlignment="HorizontalAlignment.Stretch"
                             HorizontalGap="10px">
                    <FluentStack Orientation="Orientation.Horizontal"
                                 HorizontalAlignment="HorizontalAlignment.Center"
                                 Style="width: fit-content">
                        @* Replace with AvatarGroup when available *@
                        @foreach (var user in _users.Take(4))
                        {
                            <FluentAvatar Image="@user.Avatar"
                                          Initials="@user.Initials"
                                          Shape="AvatarShape.Circle"
                                          Size="AvatarSize.Size40" />
                        }
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
                        <FluentStack HorizontalGap="8px">
                            <FluentLabel>@Room.Name</FluentLabel>
                            <FluentSpacer />

                            @if (Room.IsPinned)
                            {
                                <FluentIcon Value="@(s_Pin)" />
                            }

                            @if (Room.IsMuted)
                            {
                                <FluentIcon Value="@(s_Mute)" />
                            }
                        </FluentStack>

                        <div style="height:100%">
                            <FluentText Block Truncate Style="max-height: 48px">
                                @GetRoomPreview(Room)
                            </FluentText>
                        </div>

                        <FluentStack HorizontalAlignment="HorizontalAlignment.Right">
                            <FluentText Size="TextSize.Size100">
                                @(_lastMessage?.CreatedDate.DateTime.ToShortDateString() ?? Room.CreatedDate.DateTime.ToShortDateString())
                            </FluentText>
                        </FluentStack>
                    </FluentStack>
                </FluentStack>
            </div>

            @if (ShowMoreButton)
            {
                <FluentButton Id="@($"chat-room-menu-{Id}")" IconEnd="@(new Size24.MoreVertical())" />

                <FluentMenu Trigger="@($"chat-room-menu-{Id}")">
                    <FluentMenuList>
                        @foreach (var chatRoomAction in MoreMenuActions)
                        {
                            if (chatRoomAction.IsSeparator)
                            {
                                <FluentDivider />
                            }
                            else
                            {
                                <FluentMenuItem OnClick="@chatRoomAction.Action"
                                                IconStart="@chatRoomAction.Icon">
                                    @chatRoomAction.Label
                                </FluentMenuItem>
                            }
                        }
                    </FluentMenuList>
                </FluentMenu>
            }
        </FluentStack>
    }
    else
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
            <FluentSpinner Size="SpinnerSize.Large" />
            <FluentText Size="TextSize.Size100">
                @Localizer[LanguageResource.CX_Chat_Room_Loading]
            </FluentText>
        </FluentStack>
    }
</div>
