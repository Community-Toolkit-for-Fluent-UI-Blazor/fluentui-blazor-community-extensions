@namespace FluentUI.Blazor.Community.Components
@inherits FileManagerBase<TItem>
@typeparam TItem where TItem : class, new()

<FluentCxTileGrid MinimumColumnWidth="@ColumnWidth"
                  ColumnWidth="@ColumnWidth"
                  RowHeight="@RowHeight"
                  MinimumRowHeight="@RowHeight"
                  RowGap="8px"
                  ColumnGap="8px"
                  CanReorder="false"
                  CanResize="false"
                  Margin="10px 10px 10px 10px"
                  TItem="FileEntry<TItem>">
    @if (Entry is not null)
    {
        @foreach (var item in Entry.Children)
        {
            <TileGridItem TItem="FileEntry<TItem>"
                          Id="@($"{item.Id}-grid-item")"
                          OnClick="@(() => OnItemTappedAsync(item))"
                          OnDoubleClick="@(() => OnItemDoubleTappedAsync(item))"
                          Style="@(item.IsDirectory ? "cursor: pointer;" : null)">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    @RenderDefaultTile(item)
                }
            </TileGridItem>
        }
    }
</FluentCxTileGrid>

@code {
    private RenderFragment RenderDefaultTile(FileEntry<TItem> item) => __builder =>
   {
       <FluentCard Height="100%">
           @switch (Parent?.State.View)
           {
               case FileView.Mosaic:
               case FileView.SmallIcons:
                   <FileManagerGridItem IsSmall
                                        IsChecked="@(SelectedItems.Contains(item))"
                                        IsCheckedChanged="@(e => OnCheckedItemChangedAsync(item, e))"
                                        Entry="@(item)" />
                   break;

               case FileView.MediumIcons:
               case FileView.LargeIcons:
               case FileView.VeryLargeIcons:
                   <FileManagerGridItem IsChecked="@(SelectedItems.Contains(item))"
                                        IsCheckedChanged="@(e => OnCheckedItemChangedAsync(item, e))"
                                        Entry="@(item)" />
                   break;
           }
       </FluentCard>
   };
}
