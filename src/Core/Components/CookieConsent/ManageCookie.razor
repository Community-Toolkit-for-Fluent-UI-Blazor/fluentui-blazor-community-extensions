@namespace FluentUI.Blazor.Community.Components
@inherits FluentComponentBase

<FluentDialogBody>
    <ChildContent>
        <FluentStack VerticalGap="2px" Orientation="Orientation.Vertical">
            @foreach (var item in Content.Items)
            {
                <CookiePolicyEntryView Item="@item"
                                       OnActivationChanged="@(() => StateHasChanged())"
                                       Template="@Content.ItemTemplate" />
            } 
        </FluentStack>
    </ChildContent>

    <ActionTemplate>
        <FluentButton Style="min-width: 150px;"
                      Disabled="@ButtonsDisabled"
                      OnClick="@OnSaveAsync"
                      Appearance="ButtonAppearance.Primary">
            @Dialog.Options.Footer.PrimaryAction.Label
        </FluentButton>

        <FluentButton Style="min-width: 150px;"
                      OnClick="@OnCancelAsync">
            @Dialog.Options.Footer.SecondaryAction.Label
        </FluentButton>
    </ActionTemplate>
</FluentDialogBody>
