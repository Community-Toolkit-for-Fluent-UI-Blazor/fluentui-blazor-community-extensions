@namespace FluentUI.Blazor.Community.Components
@using FluentUI.Blazor.Community.Components.Localization
@inherits FluentComponentBase

<FluentButton Tooltip="@Localizer[LanguageResource.CX_Signature_Tools_LineDash_Tooltip]" IconOnly Id="@Id">
    <FluentIcon Value="@(new Regular.Size24.LineDashes())" />
</FluentButton>

<FluentMenu OnCheckedChanged="@OnMenuItemClickAsync" Trigger="@Id">
    <FluentMenuList>
        <FluentMenuItem Checked="@(LineDash == LineDash.Solid)"
                        Id="@($"Solid-{Id}")"
                        Role="MenuItemRole.Radio">
            <ChildContent>
                @Localizer[LanguageResource.CX_Signature_Tools_LineDash_Solid]
                <span slot="@FluentSlot.Start">
                    <FluentIcon Value="@(new Regular.Size20.LineHorizontal1())" />
                </span>
            </ChildContent>
        </FluentMenuItem>

        <FluentMenuItem Checked="@(LineDash == LineDash.DashDot)"
                        Id="@($"DashDot-{Id}")"
                        Role="MenuItemRole.Radio">
            <ChildContent>
                @Localizer[LanguageResource.CX_Signature_Tools_LineDash_DashDot]
                <span slot="@FluentSlot.Start">
                    <FluentIcon Value="@(new Regular.Size20.LineHorizontal1DashDot())" />
                </span>
            </ChildContent>
        </FluentMenuItem>
        <FluentMenuItem Checked="@(LineDash == LineDash.Dashes)"
                        Id="@($"Dashes-{Id}")"
                        Role="MenuItemRole.Radio">
            <ChildContent>
                @Localizer[LanguageResource.CX_Signature_Tools_LineDash_Dashes]
                <span slot="@FluentSlot.Start">
                    <FluentIcon Value="@(new Regular.Size20.LineHorizontal1Dashes())" />
                </span>
            </ChildContent>
        </FluentMenuItem>
        <FluentMenuItem Checked="@(LineDash == LineDash.Dots)"
                        Id="@($"Dots-{Id}")"
                        Role="MenuItemRole.Radio">
            @Localizer[LanguageResource.CX_Signature_Tools_LineDash_Dots]
            <span slot="@FluentSlot.Start">
                <FluentIcon Value="@(new Regular.Size20.LineHorizontal1Dot())" />
            </span>
        </FluentMenuItem>
    </FluentMenuList>
</FluentMenu>
