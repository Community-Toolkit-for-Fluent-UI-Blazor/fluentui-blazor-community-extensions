@namespace FluentUI.Blazor.Community.Components.Chat.UI.Viewers
@inherits FluentComponentBase

@if (Item is not null)
{
    <FluentCard Width="150px" Height="115px">
        <FluentStack Id="@Id"
                     Style="@Style"
                     Class="@Css"
                     VerticalAlignment="VerticalAlignment.Center">
            @if (_itemLoaded)
            {
                if (Template is not null)
                {
                    @Template(Item)
                }
                else
                {
                    if (Item.ContentType.StartsWith("image"))
                    {
                        <img width="90" height="90" src="@_url" style="object-fit: cover" />
                    }
                    else if (Item.ContentType.StartsWith("video"))
                    {
                        <video src="@_url" width="90" height="90" />
                    }
                    else if (Item.ContentType.StartsWith("audio"))
                    {
                        <ChatAudioFileViewer IsMinimal Source="@_url" />
                    }
                    else
                    {
                        <FluentIcon Value="@(FileIcons.GetIcon(Path.GetExtension(Item.Name), FileView.MediumIcons))"
                                    Width="90px" />
                    }
                }
            }
            else
            {
                @if (LoadingContent is not null)
                {
                    @LoadingContent
                }
                else
                {
                    <FluentStack Orientation="Orientation.Vertical"
                                 HorizontalAlignment="HorizontalAlignment.Center"
                                 VerticalAlignment="VerticalAlignment.Center">
                        <FluentSpinner />
                        <FluentText Size="TextSize.Size200">
                            @Localizer[LanguageResource.CX_Chat_FileView_Loading]
                        </FluentText>
                    </FluentStack>
                }
            }

            <FluentSpacer />

            <FluentButton IconStart=@(new Size24.Dismiss())
                          Shape="ButtonShape.Circular"
                          OnClick="@OnDismissAsync"
                          Appearance="ButtonAppearance.Subtle" />
        </FluentStack>
    </FluentCard>
}
