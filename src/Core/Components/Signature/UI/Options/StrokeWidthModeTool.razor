@namespace FluentUI.Blazor.Community.Components
@inherits FluentComponentBase

<FluentButton Tooltip="Stroke width mode" IconOnly Id="@Id">
    <FluentIcon Value="@(new Regular.Size24.InkStroke())" />
</FluentButton>

<FluentMenu OnCheckedChanged="@(OnMenuItemClickAsync)" Trigger="@Id">
    <FluentMenuList>
        <FluentMenuItem Id=@($"Default-StrokeMode-{Id}") Role="MenuItemRole.Radio">Default</FluentMenuItem>
        <FluentMenuItem Id=@($"Linear-StrokeMode-{Id}") Role="MenuItemRole.Radio">Linear</FluentMenuItem>
        <FluentMenuItem Id=@($"Power-StrokeMode-{Id}") Role="MenuItemRole.Radio">Power</FluentMenuItem>
    </FluentMenuList>
</FluentMenu>
