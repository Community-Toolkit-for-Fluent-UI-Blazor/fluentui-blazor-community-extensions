@using FluentUI.Blazor.Community.Components.Chat
@using FluentUI.Blazor.Community.Components.Chat.Files
@using FluentUI.Blazor.Community.Components.Chat.Messages
@using FluentUI.Blazor.Community.Components.Chat.Room
@using FluentUI.Blazor.Community.Components.Components.Chat
@using FluentUI.Blazor.Community.Components.Enums
@using FluentUI.Demo.Client.Infrastructure

<div style="height: 700px">
    <FluentStack HorizontalGap="8px">
        <FluentRadioGroup Items="@_users"
                          Label="Available Users"
                          @bind-Value="_selectedUser"
                          RadioLabel="@(i => $"{i?.DisplayName}")"
                          RadioValue="@(i => i?.Id.ToString())" />

        <FluentSpacer />

        <FluentSwitch Label="Split message in multi parts"
                      @bind-Value="splitMessage" />

        <FluentSwitch Label="Enable file preview"
                      @bind-Value="enableFileArea" />
    </FluentStack>

    
    <FluentCxChat TFile="FileManagerSampleFile"
                  @bind-Owner="_selectedUser"
                  RoomItemsProvider="@OnGetRoomItems"
                  UserSearchProvider="@OnGetUserSearchProvider"
                  OnRoomCreate="@OnCreateRoom"
                  FilesProvider="@GetMessageFilesProvider"
                  IsTranslationEnabled="false"
                  ItemRetrieveProvider="@GetItemRetrieveProvider"
                  ItemsProvider="@GetMessagesProvider"
                  OnCreateMessage="@OnCreateMessage"
                  OnDeleteMessage="@OnDeleteMessage"
                  OnEditMessage="@OnEditMessage"
                  OnReactMessage="@OnReactMessage"
                  ReactionsProvider="@GetReactionsProvider"
                  MessageCountProvider="@GetMessageCountProvider"
                  OnPinOrUnpinMessage="@OnUnpinChanged"
                  ReadUserStateProvider="@GetReadUserStateProvider"
                  MessageSplitOption="@(splitMessage ? ChatMessageSplitOption.SplitTextAndDocument : ChatMessageSplitOption.None)"
                  ChatFileRenderingMode="@(enableFileArea ? ChatFileRenderingMode.PreviewArea : ChatFileRenderingMode.Badge)"
                  OnRead="@OnRead"
                  OnRoomBlockChanged="@OnRoomBlockedChanged"
                  OnRoomArchiveChanged="@OnRoomArchiveChanged"
                  OnRoomHideChanged="@OnRoomHideChanged"
                  OnRoomMuteChanged="@OnRoomMuteChanged"
                  OnRoomPinChanged="@OnRoomPinChanged"
                  OnRoomDelete="@OnRoomDelete"
                  OnRoomRename="@OnRoomRename"
                  @ref="_chat" />
</div>



@code {
    private bool splitMessage = false;
    private bool enableFileArea = false;
    private FluentCxChat<FileManagerSampleFile>? _chat;

    private Dictionary<string, long> _cultures = new()
    {
        ["fr-FR"] = 1,
        ["en-US"] = 2
    };

    private readonly List<ChatMessageUserState> _chatMessageUserStates = [];

    private readonly List<ChatUser> _users = new List<ChatUser>()
    {
        new ChatUser
        {
            Id = 1,
            CultureId = 1,
            CultureName = "fr-FR",
            DisplayName = "Jérémy",
            Initials = "JJ",
            UserName = "jeremy"
        },
        new ChatUser
        {
            Id = 2,
            CultureId = 2,
            CultureName = "en-US",
            DisplayName = "Marvin",
            Initials = "MK",
            UserName = "marvin"
        },
        new ChatUser
        {
            Id = 3,
            CultureId = 2,
            CultureName = "en-US",
            DisplayName = "Pascal",
            Initials = "PV",
            UserName = "pascal"
        }
    };

    private ChatUser _selectedUser;
    private readonly List<ChatRoom> _chatRooms;
    private readonly List<ChatRoomUser> _roomUsers;
    private readonly List<ChatMessage> _messages = [];
    private readonly List<IChatFile> _files = [];
    private readonly List<ChatMessageReaction> _reactions = [];

    private static long messageIdCounter = 0;
    private static long fileIdCounter = 0;
    private static long reactionIdCounter = 0;
    private static long roomUserIdCounter = 0;
    private static long roomIdCounter = 0;

    public ChatExample()
    {
        _selectedUser = _users[0];
        _chatRooms = new List<ChatRoom>()
        {
             new ChatRoom
                {
                    Id = 1,
                    Name = "General",
                    IsDeleted = false,
                    OwnerId = _users[0].Id,
                    Owner = _users[0],
                    CreatedDate = DateTimeOffset.UtcNow.AddDays(-10),
                    IsEmpty = true
                },
                new ChatRoom
                {
                    Id = 2,
                    OwnerId = _users[1].Id,
                    Name = "Random",
                    IsDeleted = false,
                    CreatedDate = DateTimeOffset.UtcNow.AddDays(-5),
                    IsEmpty = true
                }
        };

        _roomUsers = new List<ChatRoomUser>
        {
            new ChatRoomUser { RoomId = 1, User = _users[0], UserId = _users[0].Id },
            new ChatRoomUser { RoomId = 1, User = _users[1], UserId = _users[1].Id },
            new ChatRoomUser { RoomId = 2, User = _users[1], UserId = _users[1].Id },
            new ChatRoomUser { RoomId = 2, User = _users[2], UserId = _users[2].Id }
        };

        roomIdCounter = _chatRooms.Max(r => r.Id);
    }

    private static long NextRoomId()
    {
        return Interlocked.Increment(ref roomIdCounter);
    }

    private static long NextRoomUserId()
    {
        return Interlocked.Increment(ref roomUserIdCounter);
    }

    private static long NextMessageId()
    {
        return Interlocked.Increment(ref messageIdCounter);
    }

    private static long NextFileId()
    {
        return Interlocked.Increment(ref fileIdCounter);
    }

    private static long NextReactionId()
    {
        return Interlocked.Increment(ref reactionIdCounter);
    }

    private Func<string?, StringComparison, CancellationToken, Task<IEnumerable<ChatUser>>> OnGetUserSearchProvider =>
        (searchText, comparison, cancellationToken) =>
        {
            var result = _users.Where(x => x.DisplayName?.Contains(searchText ?? string.Empty, comparison) == true);
            return Task.FromResult(result);
        };


    private ValueTask<ItemsProviderResult<ChatRoomView>> OnGetRoomItems(ChatRoomItemsRequest request, CancellationToken token)
    {
        var roomViews = new List<ChatRoomView>();

        // 1. UserRooms determines the visible rooms.
        var userRooms = request.UserFilter is not null
            ? _roomUsers.Where(request.UserFilter.Compile()).ToList()
            : _roomUsers.ToList();

        // 2. Gets the Id of the rooms where the user is participant
        var visibleRoomIds = userRooms
            .Where(x => x.UserId == _selectedUser.Id)
            .Select(x => x.RoomId)
            .ToHashSet();

        // 3. Gets the rooms based on the visible room ids and eventually apply the RoomFilter if any.
        var rooms = request.RoomFilter is not null
            ? _chatRooms.Where(request.RoomFilter.Compile()).Where(r => visibleRoomIds.Contains(r.Id)).ToList()
            : _chatRooms.Where(r => visibleRoomIds.Contains(r.Id)).ToList();

        foreach (var room in rooms)
        {
            var users = _roomUsers
                .Where(x => x.RoomId == room.Id)
                .Select(x => x.User)
                .ToList();

            var userState = _roomUsers
                .FirstOrDefault(x => x.RoomId == room.Id && x.UserId == _selectedUser.Id);

            var roomMessages = _messages
                .Where(m => m.RoomId == room.Id)
                .OrderBy(m => m.Id)
                .ToList();

            var lastMessage = roomMessages.LastOrDefault();

            var userReadStates = _chatMessageUserStates
                .Where(s => s.UserId == _selectedUser.Id && s.IsRead);

            var lastReadMessageId = userReadStates
                .Select(s => s.MessageId)
                .DefaultIfEmpty(0)
                .Max();

            var unread = roomMessages
                .Where(m => m.Id > lastReadMessageId && m.SenderId != _selectedUser.Id)
                .Count();

            roomViews.Add(new ChatRoomView
            {
                Room = room,
                Users = users,
                UserState = userState,
                LastMessage = lastMessage,
                UnreadCount = unread
            });
        }

        return ValueTask.FromResult(new ItemsProviderResult<ChatRoomView>(
            roomViews,
            roomViews.Count
        ));
    }

    private ValueTask<ChatGroupCreateResult> OnCreateRoom(
        ChatGroupCreateRequest request,
        CancellationToken cancellationToken)
    {
        var newRoom = request.Room with
        {
            Id = NextRoomId()
        };

        _chatRooms.Add(newRoom);
        _roomUsers.AddRange(request.Users.Select(u => new ChatRoomUser
        {
            RoomId = newRoom.Id,
            Id = NextRoomUserId(),
            UserId = u.Id,
            User = u
        }));

        return ValueTask.FromResult(new ChatGroupCreateResult()
        {
            Success = true,
            Room = newRoom
        });
    }

    private ValueTask<IReadOnlyList<ChatMessage>> GetMessagesProvider(ChatMessageProviderRequest request)
    {
        return ValueTask.FromResult<IReadOnlyList<ChatMessage>>(_messages.Where(request.Filter.Compile()).OrderBy(x => x.CreatedDate).ToList());
    }

    private ValueTask<IReadOnlyList<ChatMessage>> GetItemRetrieveProvider(ChatMessageItemsRequest request)
    {
        return ValueTask.FromResult<IReadOnlyList<ChatMessage>>(_messages.Where(x => request.MessageIdCollection.Contains(x.Id)).ToList());
    }

    private ValueTask<IReadOnlyList<IChatFile>> GetMessageFilesProvider(ChatMessageFileCollectionRequest request)
    {
        var files = _files.Where(x => request.MessageIdCollection.Contains(x.MessageId)).Select(x => x).ToList();
        return ValueTask.FromResult<IReadOnlyList<IChatFile>>(files);
    }

    private ValueTask<ChatMessageCreationResult> OnCreateMessage(ChatMessageItemsCreationRequest request)
    {
        List<ChatMessage> chatMessageResult = [];
        List<IChatFile> chatFileResult = [];

        foreach (var item in request.Items)
        {
            var messageId = NextMessageId();
            var message = item.Message with
            {
                Id = messageId,
                Sender = _users.FirstOrDefault(x => x.Id == item.Message.SenderId)!,
                Sections = item.Message.Sections.Select(s => s with { MessageId = messageId }).ToList()
            };

            chatMessageResult.Add(message);
            _messages.Add(message);

            foreach (var file in item.Files.OfType<ChatFile>())
            {
                var chatFile = file with
                {
                    Id = NextFileId(),
                    MessageId = messageId
                };

                _files.Add(chatFile);
                chatFileResult.Add(chatFile);
            }
        }

        var room = _chatRooms.FirstOrDefault(r => r.Id == request.RoomId);

        if (room is not null &&
            room.IsEmpty)
        {
            _chatRooms.Remove(room);

            room = room with
            {
                IsEmpty = false
            };

            _chatRooms.Add(room);
        }

        return ValueTask.FromResult(new ChatMessageCreationResult()
        {
            Messages = chatMessageResult,
            Files = chatFileResult
        });
    }

    private ValueTask OnDeleteMessage(ChatMessage message, CancellationToken token)
    {
        var msg = _messages.Find(x => x.Id == message.Id);

        if (msg is not null)
        {
            _messages.Remove(msg);

            msg = msg with
            {
                IsDeleted = true,
                DeletedDate = DateTimeOffset.UtcNow
            };

            _messages.Add(msg);
        }

        var files = _files.FindAll(x => x.MessageId == message.Id);
        _files.RemoveAll(f => files.Contains(f));

        foreach (var item in files.OfType<ChatFile>())
        {
            var file = item with
            {
                IsDeleted = true,
                DeletedDate = DateTimeOffset.UtcNow
            };

            _files.Add(file);
        }

        return ValueTask.CompletedTask;
    }

    private void OnUnpinChanged(PinMessageEventArgs e)
    {
        var msg = _messages.Find(x => x.Id == e.Message.Id);

        if (msg is not null)
        {
            _messages.Remove(msg!);
            msg = msg with
            {
                IsPinned = e.Pin
            };
            _messages.Add(msg);
        }
    }

    private ValueTask OnEditMessage(ChatMessageEditRequest request)
    {
        _messages.RemoveAll(x => x.Id == request.Message.Id);
        _messages.Add(request.Message);

        return ValueTask.CompletedTask;
    }

    private ValueTask<IReadOnlyList<ChatMessageReaction>> GetReactionsProvider(ChatMessageReactionCollectionRequest request)
    {
        return ValueTask.FromResult<IReadOnlyList<ChatMessageReaction>>(_reactions.Where(x => request.MessageIdCollection.Contains(x.Id)).ToList());
    }

    private ValueTask<int> GetMessageCountProvider(ChatMessageCountRequest request)
    {
        var filter = request.Filter.Compile();
        return ValueTask.FromResult(_messages.FindAll(x => filter(x)).Count);
    }

    private ValueTask<IReadOnlyList<ChatMessageUserState>> GetReadUserStateProvider(ChatMessageUserStateRequest request)
    {
        return ValueTask.FromResult<IReadOnlyList<ChatMessageUserState>>(_chatMessageUserStates.Where(x => request.MessageIds.Contains(x.MessageId)).ToList());
    }

    private void OnReactMessage(ChatMessageReactRequest request)
    {
        var existingReaction = _reactions.FirstOrDefault(x => x.MessageId == request.MessageId && x.UserReactedById == request.OwnerId);

        if (existingReaction is not null)
        {
            _reactions.Remove(existingReaction);
        }

        var r = new ChatMessageReaction
        {
            Id = NextReactionId(),
            MessageId = request.MessageId,
            UserReactedById = request.OwnerId,
            Emoji = request.Emoji,
            CreatedDate = DateTimeOffset.UtcNow,
            UserReactedBy = _users.FirstOrDefault(x => x.Id == request.OwnerId) ?? throw new InvalidOperationException("User not found")
        };

        _reactions.Add(r);
        request.Reaction = r;
    }

    private void OnRead(ChatMessageReadEventArgs e)
    {
        var item = _chatMessageUserStates.Find(x => x.MessageId == e.MessageId && x.UserId == e.UserId);

        if (item is null)
        {
            _chatMessageUserStates.Add(new ChatMessageUserState
            {
                MessageId = e.MessageId,
                UserId = e.UserId,
                IsRead = e.IsRead,
                ReadDate = e.ReadDate
            });
        }
        else
        {
            _chatMessageUserStates.Remove(item);

            item = item with
            {
                IsRead = e.IsRead,
                ReadDate = e.ReadDate
            };

            _chatMessageUserStates.Add(item);
        }
    }

    private void OnRoomBlockedChanged(ChatRoomEventArgs e)
    {
        var user = _roomUsers.FirstOrDefault(x => x.UserId == e.User.UserId && x.RoomId == e.User.RoomId);

        if (user is not null)
        {
            _roomUsers.Remove(user);

            user = user with
            {
                IsBlocked = e.User.IsBlocked
            };

            _roomUsers.Add(user);
        }
    }

    private void OnRoomArchiveChanged(ChatRoomEventArgs e)
    {
        var user = _roomUsers.FirstOrDefault(x => x.UserId == e.User.UserId && x.RoomId == e.User.RoomId);

        if (user is not null)
        {
            _roomUsers.Remove(user);

            user = user with
            {
                IsArchived = e.User.IsArchived
            };

            _roomUsers.Add(user);
        }
    }

    private void OnRoomHideChanged(ChatRoomEventArgs e)
    {
        var user = _roomUsers.FirstOrDefault(x => x.UserId == e.User.UserId && x.RoomId == e.User.RoomId);

        if (user is not null)
        {
            _roomUsers.Remove(user);

            user = user with
            {
                IsHidden = e.User.IsHidden
            };

            _roomUsers.Add(user);
        }
    }

    private void OnRoomMuteChanged(ChatRoomEventArgs e)
    {
        var user = _roomUsers.FirstOrDefault(x => x.UserId == e.User.UserId && x.RoomId == e.User.RoomId);

        if (user is not null)
        {
            _roomUsers.Remove(user);

            user = user with
            {
                IsMuted = e.User.IsMuted
            };

            _roomUsers.Add(user);
        }
    }

    private void OnRoomPinChanged(ChatRoomEventArgs e)
    {
        var user = _roomUsers.FirstOrDefault(x => x.UserId == e.User.UserId && x.RoomId == e.User.RoomId);

        if (user is not null)
        {
            _roomUsers.Remove(user);

            user = user with
            {
                IsPinned = e.User.IsPinned
            };

            _roomUsers.Add(user);
        }
    }

    private void OnRoomDelete(ChatRoom e)
    {
        var room = _chatRooms.FirstOrDefault(x => x.Id == e.Id);

        if (room is not null)
        {
            _chatRooms.Remove(room);

            room = room with
            {
                IsDeleted = true,
                DeletedDate = DateTimeOffset.UtcNow
            };

            _chatRooms.Add(room);
        }
    }

    private void OnRoomRename(ChatRoom e)
    {
        var room = _chatRooms.FirstOrDefault(x => x.Id == e.Id);

        if (room is not null)
        {
            _chatRooms.Remove(room);

            room = room with
            {
                Name = e.Name
            };

            _chatRooms.Add(room);
        }
    }
}
