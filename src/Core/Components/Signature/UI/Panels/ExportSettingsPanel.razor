@namespace FluentUI.Blazor.Community.Components
@inherits FluentDialogInstance

<FluentDialogBody>
    <FluentText Weight="TextWeight.Bold" Size="TextSize.Size400">Options Export</FluentText>

    <ExportSwitch Label="Include Background"
                  Description="Include the background in the exported image."
                  @bind-IsChecked="Options.IncludeBackground" />

    <ExportSwitch Label="Include Grid"
                  Description="Include the grid in the exported image."
                  @bind-IsChecked="Options.IncludeGrid" />

    <ExportSwitch Label="Include Axes"
                  Description="Include the axes in the exported image."
                  @bind-IsChecked="Options.IncludeAxes" />

    <ExportSwitch Label="Include View"
                  Description="Include the view in the exported image."
                  @bind-IsChecked="Options.IncludeView" />

    <ExportSwitch Label="Include Watermark"
                  Description="Include the watermark in the exported image."
                  @bind-IsChecked="Options.IncludeWatermark" />

    <FluentText Weight="TextWeight.Bold" Size="TextSize.Size400">Image Export</FluentText>

    @if (SurfaceExportFormat.HasFlag(Enums.SurfaceExportFormat.Avif))
    {
        <ExportSwitch Label="Export as AVIF"
                      Description="Export the image in AVIF format."
                      @bind-IsChecked="Options.ExportAvif" />
    }

    @if (SurfaceExportFormat.HasFlag(Enums.SurfaceExportFormat.Bmp))
    {
        <ExportSwitch Label="Export as BMP"
                      Description="Export the image in BMP format."
                      @bind-IsChecked="Options.ExportBmp" />
    }

    @if (SurfaceExportFormat.HasFlag(Enums.SurfaceExportFormat.Heif))
    {
        <ExportSwitch Label="Export as HEIF"
                      Description="Export the image in HEIF format."
                      @bind-IsChecked="Options.ExportHeif" />
    }

    @if (SurfaceExportFormat.HasFlag(Enums.SurfaceExportFormat.Jpeg))
    {
        <ExportSwitch Label="Export as JPEG"
                      Description="Export the image in JPEG format."
                      @bind-IsChecked="Options.ExportJpeg" />
    }

    @if (SurfaceExportFormat.HasFlag(Enums.SurfaceExportFormat.Png))
    {
        <ExportSwitch Label="Export as PNG"
                      Description="Export the image in PNG format."
                      @bind-IsChecked="Options.ExportPng" />
    }

    @if (SurfaceExportFormat.HasFlag(Enums.SurfaceExportFormat.Tiff))
    {
        <ExportSwitch Label="Export as TIFF"
                      Description="Export the image in TIFF format."
                      @bind-IsChecked="Options.ExportTiff" />
    }

    @if (SurfaceExportFormat.HasFlag(Enums.SurfaceExportFormat.Webp))
    {
        <ExportSwitch Label="Export as WEBP"
                      Description="Export the image in WEBP format."
                      @bind-IsChecked="Options.ExportWebp" />
    }

    <FluentText Weight="TextWeight.Bold" Size="TextSize.Size400">Document Export</FluentText>

    <ExportSwitch Label="Export to JSON"
                  Description="Export the document in JSON format."
                  @bind-IsChecked="Options.ExportToJson" />

    <ExportSwitch Label="Export to Binary"
                  Description="Export the document in Binary format."
                  @bind-IsChecked="Options.ExportBinary" />

    <ExportSwitch Label="Export to SVG"
                  Description="Export the document in SVG format."
                  @bind-IsChecked="Options.ExportSvg" />
</FluentDialogBody>
