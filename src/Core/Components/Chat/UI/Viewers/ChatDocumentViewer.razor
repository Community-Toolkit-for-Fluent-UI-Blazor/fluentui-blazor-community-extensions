@namespace FluentUI.Blazor.Community.Components.Chat.UI.Viewers
@inherits FluentComponentBase

<FluentCxTileGrid TItem="IChatFile"
                  ColumnWidth="250px"
                  RowHeight="250px">
    <Virtualize ItemSize="250"
                ItemsProvider="@ItemsProvider">
        <ItemContent>
            <TileGridItem ColumnSpan="1" RowSpan="1">
                <ChatFileViewItem Item=@context @key=context.Id />
            </TileGridItem>
        </ItemContent>
    </Virtualize>
</FluentCxTileGrid>
