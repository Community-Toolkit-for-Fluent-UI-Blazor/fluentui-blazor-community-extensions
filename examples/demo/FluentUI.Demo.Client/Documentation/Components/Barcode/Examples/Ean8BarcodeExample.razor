<p>
   The EAN-8 barcode is a compact symbology that encodes 8 numeric digits.
   It is commonly used for small retail products and is recognized globally for product identification and inventory management.
</p>

<div style="height: 400px">
    <FluentStack Height="100%" VerticalGap="50" Orientation="Orientation.Vertical">
        <FluentStack HorizontalGap="8px">
            <FluentTextInput Label="Value to encode as barcode"
                             @bind-Value="Value"
                             MinLength="8"
                             MaxLength="8" />
        </FluentStack>
        
        <FluentCxBarcode Value="@Value">
            <Ean8Symbology />
        </FluentCxBarcode>
    </FluentStack>
</div>

@code {
    private string Value { get; set; } = string.Empty;
}
