@namespace FluentUI.Blazor.Community.Components.Emojis
@inherits FluentComponentBase

<div id="@Id" class="@InternalClass" style="@Style">
    <div class="fluent-cx-emoji-search">
        <FluentTextInput @bind-Value="SearchText"
                         Placeholder="@Localizer["CX_Emojis_SearchPlaceholder"]"
                         Appearance="TextInputAppearance.Outline"
                         @bind-Value:after="OnSearchChangedAsync"
                         Immediate
                         Width="100%">
            <StartTemplate>
                <FluentIcon Value="@(new Size16.Search())" Color="Color.Primary" />
            </StartTemplate>
        </FluentTextInput>
    </div>

    <FluentStack Wrap HorizontalGap="12px">
        @foreach (var cat in _emojiStore.Categories)
        {
            var iconEmoji = cat.Value.FirstOrDefault();

            <FluentButton Appearance="@(SelectedCategory == cat.Key ? ButtonAppearance.Primary : ButtonAppearance.Subtle)"
                          Id="@cat.Key"
                          Title="@iconEmoji?.LocalizedCategory"
                          Style="@InternalFontFamilyStyle"
                          IconOnly
                          Size="ButtonSize.Large"
                          OnClick=@(() => SelectCategoryAsync(cat.Key))>
                <FluentEmoji Value="@GetEmojiFromCategory(cat.Key)" />
            </FluentButton>
        }
    </FluentStack>

    <div class="fluent-cx-emoji-grid">
        <Virtualize @ref="_virtualize"
                    ItemsProvider="@LoadEmojisAsync"
                    ItemSize="40">
            <ItemContent Context="row">
                 <FluentStack HorizontalGap="18px">
                    @foreach (var emoji in row.Items)
                    {
                        <FluentButton Appearance="@(SelectedEmoji == emoji ? ButtonAppearance.Primary : ButtonAppearance.Subtle)"
                                      Title="@emoji.DisplayName"
                                      IconOnly
                                      OnClick="@(() => SelectEmojiAsync(emoji))"
                                      Size="ButtonSize.Large"
                                      Style="@InternalStyle">
                            @emoji.Unicode
                        </FluentButton>
                    }
                 </FluentStack>
            </ItemContent>
        </Virtualize>
    </div>

    
</div>

