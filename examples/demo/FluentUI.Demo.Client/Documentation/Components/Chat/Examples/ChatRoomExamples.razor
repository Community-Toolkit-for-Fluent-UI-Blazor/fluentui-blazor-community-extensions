@using FluentUI.Blazor.Community.Components.Chat
@using FluentUI.Blazor.Community.Components.Chat.Room
@using FluentUI.Demo.Client.Documentation.Components.Chat.Models

<div style="height: 500px">
    <FluentStack HorizontalGap="4px">
        <FluentSwitch Label="Can Block" @bind-Checked="_canBlock" />
        <FluentSwitch Label="Can Delete" @bind-Checked="_canDelete" />
        <FluentSwitch Label="Can Hide" @bind-Checked="_canHide" />
        <FluentSwitch Label="Can Rename" @bind-Checked="_canRename" />
        <FluentSwitch Label="Can Unblock" @bind-Checked="_canUnblock" />
        <FluentSwitch Label="Can Unhide" @bind-Checked="_canUnhide" />
        <FluentSwitch Label="Is New Group Chat Enabled" @bind-Checked="_isNewGroupChatEnabled" />
    </FluentStack>

    <ChatRoomListView CanBlock="@_canBlock"
                      CanDelete="@_canDelete"
                      CanHide="@_canHide"
                      CanRename="@_canRename"
                      CanUnblock="@_canUnblock"
                      CanUnhide="@_canUnhide"
                      IsNewGroupChatEnabled="@_isNewGroupChatEnabled"
                      TChatRoom="ChatRoomEntity"
                      ItemsProvider="OnItemsProviderAsync"
                      UserSearchFunction="OnUserSearchAsync"
                      OnBlock="@OnBlock"
                      OnUnblock="@OnUnblock"
                      OnHide="@OnHide"
                      OnUnhide="@OnUnhide"
                      OnRename="@OnRename"/>
</div>

@code {
    private bool _canBlock = true;
    private bool _canDelete = true;
    private bool _canHide = true;
    private bool _canRename = true;
    private bool _canUnblock = true;
    private bool _canUnhide = true;
    private bool _isNewGroupChatEnabled = true;
    private readonly List<ChatUser> _users = new()
    {
        new ChatUser { Id = 1, UserName = "Alice", CultureId = 1, CultureName = "en-US", Initials = "AP", DisplayName = "Alice Potter" },
        new ChatUser { Id = 2, UserName = "Bob", CultureId = 2, CultureName = "fr-FR", Initials = "BM", DisplayName = "Bob Martin" },
        new ChatUser { Id = 3, UserName = "Charlie", CultureId = 1, CultureName = "en-US", Initials = "CB", DisplayName = "Charlie Brown" },
        new ChatUser { Id = 4, UserName = "Diana", CultureId = 2, CultureName = "fr-FR", Initials = "DP", DisplayName = "Diana Prince" },
        new ChatUser { Id = 5, UserName = "Eve", CultureId = 1, CultureName = "en-US", Initials = "EA", DisplayName = "Eve Adams" }
    };

    private readonly List<ChatRoomEntity> _chatRooms;

    public ChatRoomExamples()
    {
        _chatRooms = [
            new ChatRoomEntity { Id = 1, Name = "General", Owner = _users[0], Users = [_users[0], _users[1]] },
            new ChatRoomEntity { Id = 2, Name = "Project Alpha", Owner = _users[1], Users = [_users[1], _users[2]]},
            new ChatRoomEntity { Id = 3, Name = "Bob & Alice", Owner = _users[2], Users = [_users[0], _users[1]] },
            new ChatRoomEntity { Id = 4, Name = "Charlie & Eve", Owner = _users[3], Users = [_users[2], _users[4]] },
            new ChatRoomEntity { Id = 5, Name = "Diana & Alice", Owner = _users[4], Users = [_users[4], _users[0]] }
        ];
    }

    private void OnBlock(ChatRoom room)
    {
        var r = _chatRooms.Find(x => x.Id == room.Id);

        if (r is not null)
        {
            r.IsBlocked = true;
        }
    }

    private void OnUnblock(ChatRoom room)
    {
        var r = _chatRooms.Find(x => x.Id == room.Id);

        if (r is not null)
        {
            r.IsBlocked = false;
        }
    }

    private void OnHide(ChatRoom room)
    {
        var r = _chatRooms.Find(x => x.Id == room.Id);

        if (r is not null)
        {
            r.IsHidden = true;
        }
    }

    private void OnUnhide(ChatRoom room)
    {
        var r = _chatRooms.Find(x => x.Id == room.Id);

        if (r is not null)
        {
            r.IsHidden = false;
        }
    }

    private void OnRename(ChatRoom room)
    {
        var r = _chatRooms.Find(x => x.Id == room.Id);

        if (r is not null)
        {
            r.Name = room.Name;
        }
    }

    private Task<IEnumerable<ChatUser>> OnUserSearchAsync(string text, StringComparison comparison)
    {
        return Task.FromResult(_users.Where(u => u.UserName?.Contains(text, comparison) == true ||
                                                 u.DisplayName?.Contains(text, comparison) == true));
    }

    private ValueTask<IEnumerable<ChatRoom>> OnItemsProviderAsync(
        ChatRoomItemsRequest<ChatRoomEntity> request,
        CancellationToken cancellationToken = default)
    {
        if (request.Filter == null)
        {
            return new ValueTask<IEnumerable<ChatRoom>>(_chatRooms.Select(x => new ChatRoom()
            {
                CreatedDate = DateTime.Now,
                Id = x.Id,
                Name = x.Name,
                Owner = new ChatUser()
                {
                    Id = x.Owner!.Id,
                    UserName = x.Owner!.UserName,
                    CultureId = x.Owner!.CultureId,
                    CultureName = x.Owner!.CultureName,
                    Initials = x.Owner!.Initials,
                    DisplayName = x.Owner!.DisplayName
                },
                Users = x.Users.Select(u => new ChatUser()
                {
                    Id = u.Id,
                    UserName = u.UserName,
                    CultureId = u.CultureId,
                    CultureName = u.CultureName,
                    Initials = u.Initials,
                    DisplayName = u.DisplayName
                }).ToList()
            }));
        }

        return new ValueTask<IEnumerable<ChatRoom>>(_chatRooms.Where(request.Filter.Compile()).Select(x => new ChatRoom()
        {
            CreatedDate = DateTime.Now,
            Id = x.Id,
            Name = x.Name,
            Owner = new ChatUser()
            {
                Id = x.Owner!.Id,
                UserName = x.Owner!.UserName,
                CultureId = x.Owner!.CultureId,
                CultureName = x.Owner!.CultureName,
                Initials = x.Owner!.Initials,
                DisplayName = x.Owner!.DisplayName
            },
            Users = x.Users.Select(u => new ChatUser()
            {
                Id = u.Id,
                UserName = u.UserName,
                CultureId = u.CultureId,
                CultureName = u.CultureName,
                Initials = u.Initials,
                DisplayName = u.DisplayName
            }).ToList()
        }));
    }
}
