<FluentStack VerticalGap="4px" Orientation="Orientation.Vertical">
    <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4px" Wrap>
        <FluentSelect Items=@s_ratioModes
                      Label="Select ratio mode"
                      TOption="SlideshowRatioMode"
                      TValue="SlideshowRatioMode"
                      @bind-Value="_selectedRatioMode" />

        <FluentSelect Items=@s_ratios
                      Label="Select aspect ratio"
                      TOption="SlideshowContentRatio"
                      TValue="SlideshowContentRatio"
                      @bind-Value="_selectedRatio" />

        @if (_showIndicators || _selectedLoop != SlideshowLoopingMode.Infinite)
        {
            <FluentSelect Items=@s_indicator_positions
                          Label="Position of the indicator"
                          TOption="SlideshowIndicatorPosition"
                          TValue="SlideshowIndicatorPosition"
                          @bind-Value="_selectedPosition" />
        }

        @if(!_showControls || _selectedLoop == SlideshowLoopingMode.Infinite)
        {
            <FluentSelect Items=@s_orientations
                          Label="Orientation of the slides"
                          TOption="Orientation"
                          TValue="Orientation"
                          @bind-Value="_selectedOrientation" />
        }

        <FluentSelect Items=@s_loops
                      Label="Loop mode"
                      TOption="SlideshowLoopingMode"
                      TValue="SlideshowLoopingMode"
                      @bind-Value="_selectedLoop" />

        <FluentSwitch Label="Autoplay" @bind-Value="_isAutoplay" />

        <FluentSwitch Label="Show controls" @bind-Value="_showControls" />
        
        @if (_selectedLoop != SlideshowLoopingMode.Infinite)
        {
            <FluentSwitch Label="Show indicators" @bind-Value="_showIndicators" />
        }

        <FluentSwitch Label="Touch enabled" @bind-Value="_touchEnabled" />
    </FluentStack>

    <div style="width: 100%; height: 600px">
        <FluentCxSlideshow ShowControls="@_showControls"
                           ShowIndicators="@_showIndicators"
                           ContentRatio="@_selectedRatio"
                           RatioMode="@_selectedRatioMode"
                           IsTouchEnabled="@_touchEnabled"
                           IndicatorPosition="@_selectedPosition"
                           LoopMode="@_selectedLoop"
                           Autoplay="@_isAutoplay"
                           Orientation="@_selectedOrientation">
            <SlideshowItem>
                <SlideshowImage Source="images/ship-1.png" />
            </SlideshowItem>
            <SlideshowItem>
                <SlideshowImage Source="images/ship-2.png" />
            </SlideshowItem>
        </FluentCxSlideshow>
    </div>
</FluentStack>

@code {
    private static readonly SlideshowContentRatio[] s_ratios = Enum.GetValues<SlideshowContentRatio>();
    private static readonly SlideshowRatioMode[] s_ratioModes = Enum.GetValues<SlideshowRatioMode>();
    private static readonly SlideshowIndicatorPosition[] s_indicator_positions = Enum.GetValues<SlideshowIndicatorPosition>();
    private static readonly Orientation[] s_orientations = Enum.GetValues<Orientation>();
    private static readonly SlideshowLoopingMode[] s_loops = Enum.GetValues<SlideshowLoopingMode>();

    private SlideshowContentRatio _selectedRatio = SlideshowContentRatio.Original;
    private SlideshowRatioMode _selectedRatioMode = SlideshowRatioMode.Image;
    private SlideshowIndicatorPosition _selectedPosition = SlideshowIndicatorPosition.Bottom;
    private Orientation _selectedOrientation = Orientation.Horizontal;
    private SlideshowLoopingMode _selectedLoop = SlideshowLoopingMode.None;
    private bool _showControls = true;
    private bool _showIndicators = true;
    private bool _touchEnabled = true;
    private bool _isAutoplay = false;
}
