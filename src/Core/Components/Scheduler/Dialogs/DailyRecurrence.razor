@namespace FluentUI.Blazor.Community.Components
@using System.Globalization
@using FluentUI.Blazor.Community.Components.Localization

@if (Recurrence is not null)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="1px" Margin="@MarginUtils.Bottom3">
            <FluentText Weight="TextWeight.Bold">@string.Format(Culture, Localizer[LanguageResource.CX_Scheduler_RepeatEveryXDays], Recurrence.Interval)</FluentText>
            @* <FluentNumberField @bind-Value="Recurrence.Interval" Min="1" Step="1" /> *@
            <FluentTextInput TextInputType="TextInputType.Number"
                             AriaLabel="@string.Format(Culture, Localizer[LanguageResource.CX_Scheduler_RepeatEveryXDays], Recurrence.Interval)"
                             @bind-Value="_interval"
                             @bind-Value:after="SetToRecurrenceInterval" />
                             
        </FluentStack>
    
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4" Style="margin-bottom: 12px">
            <FluentText Weight="TextWeight.Bold">@Localizer[LanguageResource.CX_Scheduler_EndOfRecurrence]</FluentText>
            <FluentStack HorizontalAlignment="HorizontalAlignment.Stretch" HorizontalGap="2" Style="margin-bottom: 5px">
                <FluentButton Style="flex: 1; min-width: 120px;"
                              OnClick="@(() => _endMode = 0)"
                              Appearance="@(GetAppearance(_endMode == 0))">
                    @Localizer[LanguageResource.CX_Scheduler_Never];
                </FluentButton>

                <FluentButton Style="flex: 1; min-width: 120px;"
                              OnClick="@(() => _endMode = 1)"
                              Appearance="@(GetAppearance(_endMode == 1))">
                    @Localizer[LanguageResource.CX_Scheduler_Until];
                </FluentButton>

                <FluentButton Style="flex: 1; min-width: 120px;"
                              OnClick="@(() => _endMode = 2)"
                              Appearance="@(GetAppearance(_endMode == 2))">
                    @string.Format(Culture, @Localizer[LanguageResource.CX_Scheduler_AfterXOccurrences], Recurrence.Count ?? 0)
                </FluentButton>
            </FluentStack>

            @if (_endMode == 1)
            {
                <FluentDatePicker Label="@Localizer[LanguageResource.CX_Scheduler_Until]"
                                  AriaLabel="@Localizer[LanguageResource.CX_Scheduler_Until]"
                                  @bind-Value="Recurrence.Until" />
            }
            else if (_endMode == 2)
            {
                @* <FluentNumberField @bind-Value="Recurrence.Count"
                                   Label="@string.Format(Culture, Localizer[LanguageResource.CX_Scheduler_AfterXOccurrences], Recurrence.Count)"
                                   AriaLabel="@string.Format(Culture, Localizer[LanguageResource.CX_Scheduler_AfterXOccurrences], Recurrence.Count)"
                                   Step="1"
                                   Min="1" /> *@
                <FluentTextInput AriaLabel="@string.Format(Culture, Localizer[LanguageResource.CX_Scheduler_AfterXOccurrences], Recurrence.Count)"
                                 Label="@string.Format(Culture, Localizer[LanguageResource.CX_Scheduler_AfterXOccurrences], Recurrence.Count)"
                                 @bind-Value="_afterXOccurrences"
                                 @bind-Value:after="SetAfterXOccurrences" />
            }
        </FluentStack>       

        <!-- Exceptions -->
        <FluentText Weight="TextWeight.Bold">
            @Localizer[LanguageResource.CX_Scheduler_DateExceptions]
        </FluentText>
        <FluentStack Style="margin-bottom: 12px">
            <FluentDatePicker @bind-Value="_exceptionDate" />
            <FluentButton OnClick="@AddException">@Localizer[LanguageResource.CX_Scheduler_Add]</FluentButton>
        </FluentStack>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
            @foreach (var ex in Exceptions)
            {
                <FluentStack>
                    <FluentLabel>@ex.ToShortDateString()</FluentLabel>
                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                  IconStart="@(new Size24.Dismiss())"
                                  Title="@Localizer[LanguageResource.CX_Scheduler_RemoveDateExceptions]"
                                  OnClick="@(() => RemoveException(ex))"/>
                </FluentStack>
            }
        </FluentStack>
    </FluentStack>
}
