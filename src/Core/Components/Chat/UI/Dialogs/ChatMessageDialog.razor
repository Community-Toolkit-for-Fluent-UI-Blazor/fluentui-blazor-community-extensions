@namespace FluentUI.Blazor.Community.Components.Chat.UI.Dialogs
@inherits FluentDialogInstance

<FluentDialogBody Id="@Id">
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size24.ContentView())" />

            <FluentText Size="TextSize.Size700">
                @Localizer[LanguageResource.CX_Chat_Message_Viewer_Title]
            </FluentText>
        </FluentStack>
    </TitleTemplate>

    <ChildContent>
        <FluentCxSlideshow ContentRatio="SlideshowContentRatio.Landscape"
                           RatioMode="SlideshowRatioMode.Container"
                           LoopMode="SlideshowLoopingMode.Infinite"
                           IsTouchEnabled>
            @if (_files.Count > 0)
            {
                foreach (var file in _files)
                {
                    var item = file;

                    <SlideshowItem>
                        @if (item.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                        {
                            <SlideshowImage Source="@item.Url" />
                        }
                        else if (item.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase))
                        {
                            <SlideshowVideo Source="@item.Url" />
                        }
                    </SlideshowItem>
                }
            }
        </FluentCxSlideshow>
    </ChildContent>
</FluentDialogBody>
