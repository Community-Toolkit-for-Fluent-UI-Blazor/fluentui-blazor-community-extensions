@using FluentUI.Blazor.Community.Components.Charts.Series
@using FluentUI.Blazor.Community.Components.Charts.Themes
@using FluentUI.Blazor.Community.Components.Enums
<p>
    This example demonstrates how to use some hierarchy charts with sample data.
</p>

<div style="width: 100%; height: 500px">
    <FluentStack Height="100%" Orientation="Orientation.Vertical">
        <FluentStack HorizontalGap="4px">
            <FluentSelect Items="@s_chartPaletteStyles"
                          @bind-Value="_selectedChartPaletteStyle" />

           <FluentSelect Items="@s_chartCategory"
                          @bind-Value="_selectedChartCategory"
                          @bind-Value:after="OnHierarchyChanged" />
        </FluentStack>

        <FluentCxChart @ref="_ref" PaletteStyle="@_selectedChartPaletteStyle">
            @if (_selectedChartCategory == ChartType.Treemap)
            {
                <TreemapSerie Name="Treemap" Items="@(_books)" Group="x => new[] { x.Genre, x.SubGenre, x.Name }" />
            }
            else if (_selectedChartCategory == ChartType.Partition)
            {
                <PartitionSerie Name="Partition" Items="@(_books)" Group="x => new[] { x.Genre, x.SubGenre, x.Name }" />
            }
            else if (_selectedChartCategory == ChartType.Icicle)
            {
                <IcicleSerie Name="Icicle" Items="@(_books)" Group="x => new[] { x.Genre, x.SubGenre, x.Name }" />
            }
            else if (_selectedChartCategory == ChartType.Sunburst)
            {
                <SunburstSerie Name="Sunburst" Items="@(_books)" Group="x => new[] { x.Genre, x.SubGenre, x.Name }" />
            }
            else if (_selectedChartCategory == ChartType.Tree)
            {
                <TreeSerie Name="Tree" Items="@(_books)" Group="x => new[] { x.Genre, x.SubGenre, x.Name }" />
            }
            else if (_selectedChartCategory == ChartType.RadialTree)
            {
                <RadialTreeSerie Name="RadialTree" Items="@(_books)" Group="x => new[] { x.Genre, x.SubGenre, x.Name }" />
            }
            else if (_selectedChartCategory == ChartType.Dendrogram)
            {
                <DendrogramSerie Name="Dendrogram" Items="@(_books)" Group="x => new[] { x.Genre, x.SubGenre, x.Name }" />
            }
        </FluentCxChart>
    </FluentStack>
</div>


