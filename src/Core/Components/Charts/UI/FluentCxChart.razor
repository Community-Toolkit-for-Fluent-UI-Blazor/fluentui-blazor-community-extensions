@namespace FluentUI.Blazor.Community.Components
@inherits FluentComponentBase

<CascadingValue Value="this" IsFixed>
    <div id="@Id" style="@Style" class="chart @Class">
        <ChartOptions>
            @Options
        </ChartOptions>
        @ChildContent

        @if (_isVisible)
        {
            <div>
                @GetRenderTargetMarkup()
            </div>
        }
    </div>
</CascadingValue>
