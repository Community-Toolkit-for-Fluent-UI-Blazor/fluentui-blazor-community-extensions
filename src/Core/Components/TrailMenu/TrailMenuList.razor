@namespace FluentUI.Blazor.Community.Components
@using FluentUI.Blazor.Community.Components.TrailMenu
@inherits FluentComponentBase

@if (Items.Any())
{
    <FluentButton IconOnly
                  Id="@Id"
                  Appearance="ButtonAppearance.Subtle"
                  Size="ButtonSize.Large"
                  OnClick="@(() => _isOpened = !_isOpened)">
        <FluentIcon Value="@(_isOpened ? TrailMenuIcons.ChevronDown : TrailMenuIcons.ChevronRight)" />
    </FluentButton>

    <FluentPopover AnchorId="@Id"
                   @bind-Opened="_isOpened">
        <FluentMenuList>
            @foreach (var item in Items)
            {
                <FluentMenuItem Id="@($"fui-menu-item-{item.Id}")"
                                Role="MenuItemRole.MenuItem"
                                OnClick="@(() => OnItemTappedAsync(item))">
                    @item.Label
                </FluentMenuItem>
            }
        </FluentMenuList>
    </FluentPopover>
}

